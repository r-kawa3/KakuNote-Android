<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- いつも明るい色（端末がダークモードでも変えない）。起動の瞬間の背景も生成り色にする -->
    <style name="Theme.KakuNote" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/wa_background</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!--
      起動画面: 生成り色の背景に、藍の「画」と朱の印。Android 12 以上の起動画面の仕組みを、
      core-splashscreen で Android 10・11 でも同じ見た目にする。漢字のデータを読み込むあいだ出しておく
    -->
    <style name="Theme.KakuNote.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/wa_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.KakuNote</item>
    </style>
</resources>
